# Игнорировать всё
*

# Не игнорировать нужные файлы и папки
!src/
!pom.xml
!README.md
!.gitignore

# Игнорировать всё внутри src, кроме исходного кода
src/*
!src/main/
!src/test/

# Игнорировать всё внутри main и test, кроме java и resources
src/main/*
!src/main/java/
!src/main/resources/

src/test/*
!src/test/java/
!src/test/resources/

# Игнорировать скомпилированные файлы
*.class
*.jar
*.war
*.ear

# Игнорировать логи и временные файлы
*.log
*.tmp
*.temp

# Игнорировать файлы IDE
.idea/
*.iml
*.iws
*.ipr
.vscode/
.settings/
.classpath
.project

# Игнорировать файлы сборки
target/
build/
out/